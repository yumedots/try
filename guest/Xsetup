#!/bin/sh
# Xsetup - run as root before the login dialog appears

[ -r /run/try/xsettingsd.conf ] || exit 0

if ! pgrep -x xsettingsd >/dev/null; then
    /usr/bin/xsettingsd -c /run/try/xsettingsd.conf >/dev/null 2>&1 </dev/null &
fi

[ -r /run/try/xft.dpi ] && /usr/bin/xrdb -merge /run/try/xft.dpi

echo "tryDisplay: xft $(cat /run/try/xft.dpi) via Xsetup" > /dev/ttyAMA0
